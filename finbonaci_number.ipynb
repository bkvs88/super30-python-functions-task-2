   "source": [
    "# Define the recursive lambda function\n",
    "fibonacci = lambda n: n if n <= 1 else fibonacci(n - 1) + fibonacci(n-2) # stop the recursion when n hits 1 or, included recursive stap for n* factorial(n-1)\n"
   ]
