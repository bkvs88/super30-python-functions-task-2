   "source": [
    "Write a recursive function to calculate factorial."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "393dc568",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the recursive lambda function\n",
    "factorial = lambda n: 1 if n <= 1 else n * factorial(n - 1) # stop the recursion when n hits 1 or, included recursive stap for n* factorial(n-1)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "44be69a1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "120\n"
     ]
    }
   ],
   "source": [
    "print(factorial(5))  \n",
    "\n"
   ]
