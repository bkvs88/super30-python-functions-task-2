   "source": [
    "Write a recursive function to calculate 1 + 2 + 3 + ... + n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "8ecbdd92",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the recursive lambda function\n",
    "recursive_sum = lambda n: 1 if n <= 1 else n + recursive_sum(n - 1) # stop the recursion when n hits 1 or, included recursive stap for n+factorial(n-1)\n"
   ]
  },
